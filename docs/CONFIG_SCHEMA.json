{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://streamforge.io/schemas/config/v1.json",
  "title": "StreamForge Configuration",
  "description": "Configuration schema for StreamForge Kafka streaming pipelines",
  "type": "object",
  "required": ["appid", "bootstrap", "input"],
  "anyOf": [
    {"required": ["output"]},
    {"required": ["routing"]}
  ],
  "properties": {
    "appid": {
      "type": "string",
      "description": "Unique application/consumer group identifier",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "examples": ["user-processor", "event-filter", "data-sync"]
    },
    "bootstrap": {
      "type": "string",
      "description": "Kafka bootstrap servers (comma-separated)",
      "minLength": 1,
      "examples": ["localhost:9092", "kafka1:9092,kafka2:9092"]
    },
    "target_broker": {
      "type": "string",
      "description": "Target Kafka bootstrap servers; defaults to bootstrap"
    },
    "input": {
      "type": "string",
      "description": "Source Kafka topic to consume from",
      "minLength": 1,
      "examples": ["events", "users", "orders"]
    },
    "output": {
      "type": "string",
      "description": "Destination topic in single-destination mode",
      "minLength": 1
    },
    "transform": {
      "type": "string",
      "description": "Native value-transform DSL expression in single-destination mode"
    },
    "wasm": {
      "type": "object",
      "description": "Digest-pinned stateless WebAssembly component registry",
      "required": ["module_root", "modules"],
      "properties": {
        "module_root": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical trust root containing every configured component"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "max_module_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456, "default": 16777216},
            "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864, "default": 1048576},
            "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864, "default": 1048576},
            "max_memory_bytes": {"type": "integer", "minimum": 65536, "maximum": 536870912, "multipleOf": 65536, "default": 67108864},
            "max_table_elements": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 10000},
            "max_execution_ms": {"type": "integer", "minimum": 1, "maximum": 60000, "default": 5},
            "epoch_tick_ms": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1},
            "max_wasm_stack_bytes": {"type": "integer", "minimum": 65536, "maximum": 16777216, "default": 2097152},
            "max_concurrent_instances": {"type": "integer", "minimum": 1, "maximum": 1024, "default": 256}
          },
          "additionalProperties": false
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["name", "path", "sha256", "world", "abi"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "path": {"type": "string", "minLength": 1},
              "sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "world": {
                "type": "string",
                "enum": ["filter", "value_transform", "envelope_transform"]
              },
              "abi": {"type": "string", "enum": ["v1"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "udfs": {
      "$ref": "#/definitions/destinationUdfs"
    },
    "offset": {
      "type": "string",
      "description": "Initial offset position for new consumer groups",
      "enum": ["earliest", "latest", "stored"],
      "default": "latest"
    },
    "threads": {
      "type": "integer",
      "description": "Number of processing threads (1 per CPU core recommended)",
      "minimum": 1,
      "maximum": 64,
      "default": 4
    },
    "compression": {
      "type": "object",
      "properties": {
        "compression_type": {
          "type": "string",
          "enum": ["none", "raw", "enveloped"],
          "default": "none"
        },
        "compression_algo": {
          "type": "string",
          "enum": ["gzip", "snappy", "zstd", "lz4"],
          "default": "gzip"
        }
      }
    },
    "consumer_properties": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "producer_properties": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "commit_strategy": {
      "type": "object",
      "description": "Offset commit and legacy DLQ compatibility settings",
      "properties": {
        "manual_commit": {"type": "boolean", "default": false},
        "commit_mode": {"type": "string", "enum": ["async", "sync"], "default": "async"},
        "commit_interval_ms": {"type": "integer", "minimum": 1, "default": 5000},
        "enable_dlq": {"type": "boolean", "default": false},
        "dlq_topic": {"type": ["string", "null"]},
        "max_retries": {"type": "integer", "minimum": 0, "default": 3},
        "retry_backoff": {
          "type": "object",
          "properties": {
            "initial_backoff_ms": {"type": "integer", "minimum": 0, "default": 100},
            "max_backoff_ms": {"type": "integer", "minimum": 0, "default": 30000},
            "multiplier": {"type": "number", "exclusiveMinimum": 0, "default": 2.0}
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "description": "Runtime batching and selected librdkafka performance settings. Explicit consumer_properties and producer_properties entries take precedence.",
      "properties": {
        "consumer_batch_size": {
          "type": "integer",
          "description": "Maximum messages collected for one processing batch",
          "minimum": 1,
          "default": 100
        },
        "consumer_batch_timeout_ms": {
          "type": "integer",
          "description": "Maximum wait for a partially filled legacy batch and idle queued-delivery flush delay in partition_ordered mode (ms)",
          "minimum": 1,
          "default": 100
        },
        "parallelism_factor": {
          "type": "integer",
          "description": "Concurrent processing multiplier applied to threads",
          "minimum": 1,
          "default": 10
        },
        "processing_mode": {
          "type": "string",
          "description": "Runtime scheduling mode. partition_ordered uses bounded FIFO worker lanes keyed by source partition.",
          "enum": ["legacy_batch", "partition_ordered"],
          "default": "legacy_batch"
        },
        "worker_queue_capacity": {
          "type": "integer",
          "description": "Per-worker bounded queue capacity in partition_ordered mode",
          "minimum": 1,
          "default": 1024
        },
        "producer_delivery_mode": {
          "type": "string",
          "description": "acknowledged waits for each delivery result; queued tracks bounded asynchronous deliveries and is restricted to auto-commit with retries and DLQ disabled",
          "enum": ["acknowledged", "queued"],
          "default": "acknowledged"
        },
        "producer_max_in_flight": {
          "type": "integer",
          "description": "Maximum pending delivery futures in queued mode",
          "minimum": 1,
          "default": 10000
        },
        "fetch_min_bytes": {
          "type": "integer",
          "description": "Maps to librdkafka fetch.min.bytes",
          "minimum": 1,
          "maximum": 4294967295
        },
        "fetch_max_wait_ms": {
          "type": "integer",
          "description": "Maps to librdkafka fetch.wait.max.ms",
          "minimum": 0,
          "maximum": 4294967295
        },
        "queue_buffering_max_ms": {
          "type": "integer",
          "description": "Maps to librdkafka queue.buffering.max.ms; linger_ms takes precedence when both are set",
          "minimum": 0
        },
        "batch_size": {
          "type": "integer",
          "description": "Maximum producer batch message count; maps to librdkafka batch.num.messages",
          "minimum": 1
        },
        "linger_ms": {
          "type": "integer",
          "description": "Maps to librdkafka linger.ms; takes precedence over queue_buffering_max_ms",
          "minimum": 0
        }
      }
    },
    "retry": {
      "type": "object",
      "description": "Retry policy for transient failures",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "description": "Maximum retry attempts",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "initial_delay_ms": {
          "type": "integer",
          "description": "Initial retry delay (ms)",
          "minimum": 10,
          "maximum": 60000,
          "default": 100
        },
        "max_delay_ms": {
          "type": "integer",
          "description": "Maximum retry delay (ms)",
          "minimum": 100,
          "maximum": 300000,
          "default": 30000
        },
        "multiplier": {
          "type": "number",
          "minimum": 1,
          "default": 2.0
        },
        "jitter": {
          "type": "number",
          "description": "Jitter factor from 0.0 through 1.0",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1
        }
      }
    },
    "dlq": {
      "type": "object",
      "description": "Dead Letter Queue configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable DLQ for failed messages",
          "default": true
        },
        "topic": {
          "type": "string",
          "description": "DLQ topic name",
          "default": "streamforge-dlq"
        },
        "brokers": {
          "type": ["string", "null"],
          "description": "Optional Kafka broker override for the DLQ"
        },
        "include_original_headers": {
          "type": "boolean",
          "description": "Include original record headers",
          "default": true
        },
        "include_stack_trace": {
          "type": "boolean",
          "default": false
        },
        "max_dlq_retries": {
          "type": "integer",
          "description": "Maximum retries when a DLQ write fails",
          "minimum": 0,
          "default": 3
        },
        "compression": {
          "type": ["string", "null"]
        }
      }
    },
    "security": {
      "$ref": "#/definitions/security",
      "description": "Source Kafka security; also used for the target when target_security is omitted"
    },
    "target_security": {
      "$ref": "#/definitions/security",
      "description": "Optional target Kafka security override"
    },
    "routing": {
      "type": "object",
      "description": "Message routing configuration",
      "required": ["routing_type", "destinations"],
      "properties": {
        "routing_type": {
          "type": "string",
          "description": "Routing strategy",
          "enum": ["filter", "fanout", "passthrough"],
          "examples": ["filter", "fanout"]
        },
        "destinations": {
          "type": "array",
          "description": "List of destination configurations",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["output"],
            "properties": {
              "output": {
                "type": "string",
                "description": "Destination Kafka topic",
                "minLength": 1
              },
              "filter": {
                "type": "string",
                "description": "DSL filter expression",
                "examples": [
                  "/status,==,active",
                  "AND:/age,>,18:/region,==,us",
                  "KEY_PREFIX:user-"
                ]
              },
              "transform": {
                "type": "string",
                "description": "DSL transform expression",
                "examples": [
                  "/data",
                  "EXTRACT:/user/id,user_id",
                  "CONSTRUCT:id=/id:name=/name"
                ]
              },
              "key_transform": {
                "type": "string",
                "description": "Transform for message key",
                "examples": ["/user/id", "HASH:MD5,/email"]
              },
              "partition": {
                "type": "string",
                "description": "JSON path used for field-based partitioning",
                "examples": ["/user/region", "/tenant/id"]
              },
              "timestamp": {
                "type": "string",
                "description": "PRESERVE, CURRENT, a JSON path, ADD:seconds, or SUBTRACT:seconds"
              },
              "broadcast": {
                "type": "boolean",
                "default": false
              },
              "headers": {
                "type": "object",
                "description": "Additional headers to add to messages",
                "additionalProperties": {
                  "type": "string"
                },
                "examples": [
                  {
                    "x-pipeline": "user-processor",
                    "x-version": "1.0"
                  }
                ]
              },
              "udfs": {
                "$ref": "#/definitions/destinationUdfs"
              }
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "description": "Observability and metrics configuration",
      "properties": {
        "metrics_enabled": {
          "type": "boolean",
          "description": "Enable Prometheus metrics",
          "default": true
        },
        "metrics_port": {
          "type": "integer",
          "description": "HTTP port for metrics endpoint",
          "minimum": 1,
          "maximum": 65535,
          "default": 9090
        },
        "metrics_bind_address": {
          "type": "string",
          "description": "IP address on which the observability server listens",
          "default": "0.0.0.0"
        },
        "metrics_path": {
          "type": "string",
          "description": "Metrics endpoint path",
          "default": "/metrics"
        },
        "lag_monitoring_enabled": {
          "type": "boolean",
          "default": true
        },
        "lag_monitoring_interval_secs": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      }
    },
    "cache": {
      "type": "object",
      "description": "Caching configuration for enrichment",
      "required": ["backend_type"],
      "properties": {
        "backend_type": {
          "type": "string",
          "enum": ["local", "redis", "kafka", "multi"]
        },
        "local": {
          "type": ["object", "null"],
          "properties": {
            "max_capacity": {"type": "integer", "minimum": 1, "default": 10000},
            "ttl_seconds": {"type": ["integer", "null"], "minimum": 1},
            "tti_seconds": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "redis": {
          "type": ["object", "null"],
          "required": ["url"],
          "properties": {
            "url": {"type": "string"},
            "pool_size": {"type": "integer", "minimum": 1},
            "key_prefix": {"type": ["string", "null"]},
            "default_ttl_seconds": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "kafka": {
          "type": ["object", "null"],
          "required": ["bootstrap", "topic", "group_id", "key_field"],
          "properties": {
            "bootstrap": {"type": "string"},
            "topic": {"type": "string"},
            "group_id": {"type": "string"},
            "key_field": {"type": "string"},
            "value_field": {"type": "string", "default": "."},
            "warmup_on_start": {"type": "boolean", "default": true}
          }
        }
      }
    }
  },
  "definitions": {
    "destinationUdfs": {
      "type": "object",
      "description": "Named WebAssembly modules bound to destination stages",
      "minProperties": 1,
      "properties": {
        "filter": {"type": "string", "minLength": 1},
        "value_transform": {"type": "string", "minLength": 1},
        "envelope_transform": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": {
          "type": "string",
          "enum": ["PLAINTEXT", "SSL", "SASL_PLAINTEXT", "SASL_SSL"]
        },
        "ssl": {
          "type": "object",
          "properties": {
            "ca_location": {"type": "string", "description": "Path to the CA certificate"},
            "certificate_location": {"type": "string", "description": "Path to the client certificate"},
            "key_location": {"type": "string", "description": "Path to the client private key"},
            "key_password": {"type": "string", "deprecated": true, "description": "Compatibility-only inline private-key password; prefer key_password_file"},
            "key_password_file": {"type": "string", "description": "Path to a protected file containing the private-key password"},
            "endpoint_identification_algorithm": {"type": "string", "description": "TLS hostname verification algorithm"}
          }
        },
        "sasl": {
          "type": "object",
          "required": ["mechanism"],
          "properties": {
            "mechanism": {
              "type": "string",
              "enum": ["PLAIN", "SCRAM-SHA-256", "SCRAM-SHA-512", "GSSAPI", "OAUTHBEARER"]
            },
            "username": {"type": "string", "deprecated": true, "description": "Compatibility-only inline username; prefer username_file"},
            "password": {"type": "string", "deprecated": true, "description": "Compatibility-only inline password; prefer password_file"},
            "username_file": {"type": "string", "description": "Path to a protected file containing the SASL username"},
            "password_file": {"type": "string", "description": "Path to a protected file containing the SASL password"},
            "kerberos_service_name": {"type": "string"},
            "kerberos_principal": {"type": "string"},
            "kerberos_keytab": {"type": "string", "description": "Path to a protected Kerberos keytab"},
            "oauthbearer_token": {"type": "string", "deprecated": true, "description": "Compatibility-only inline OAuth bearer token"}
          }
        }
      }
    }
  },
  "examples": [
    {
      "appid": "user-processor",
      "bootstrap": "kafka:9092",
      "input": "users",
      "offset": "latest",
      "threads": 4,
      "performance": {
        "consumer_batch_size": 100,
        "consumer_batch_timeout_ms": 100,
        "parallelism_factor": 10,
        "fetch_min_bytes": 1024,
        "batch_size": 1000,
        "linger_ms": 10
      },
      "retry": {
        "max_attempts": 3,
        "initial_delay_ms": 100,
        "max_delay_ms": 30000,
        "multiplier": 2.0,
        "jitter": 0.1
      },
      "dlq": {
        "enabled": true,
        "topic": "user-processor-dlq",
        "include_original_headers": true
      },
      "routing": {
        "routing_type": "filter",
        "destinations": [
          {
            "output": "active-users",
            "filter": "/status,==,active",
            "transform": "/data",
            "key_transform": "/user/id",
            "headers": {
              "x-pipeline": "user-processor"
            }
          }
        ]
      },
      "observability": {
        "metrics_enabled": true,
        "metrics_port": 9090
      }
    },
    {
      "appid": "cross-region-sync",
      "bootstrap": "kafka-us-east:9092",
      "target_broker": "kafka-us-west:9092",
      "input": "events",
      "offset": "earliest",
      "threads": 8,
      "performance": {
        "consumer_batch_size": 500,
        "consumer_batch_timeout_ms": 50,
        "parallelism_factor": 10,
        "fetch_min_bytes": 10240,
        "batch_size": 5000,
        "linger_ms": 50
      },
      "security": {
        "protocol": "SASL_SSL",
        "ssl": {
          "ca_location": "/certs/ca.crt",
          "certificate_location": "/certs/client.crt",
          "key_location": "/certs/client.key"
        },
        "sasl": {
          "mechanism": "SCRAM-SHA-512",
          "username_file": "/run/secrets/source-kafka-username",
          "password_file": "/run/secrets/source-kafka-password"
        }
      },
      "target_security": {
        "protocol": "SASL_SSL",
        "ssl": {
          "ca_location": "/certs/target-ca.crt"
        },
        "sasl": {
          "mechanism": "SCRAM-SHA-512",
          "username_file": "/run/secrets/target-kafka-username",
          "password_file": "/run/secrets/target-kafka-password"
        }
      },
      "routing": {
        "routing_type": "passthrough",
        "destinations": [
          {
            "output": "events",
            "timestamp": "PRESERVE"
          }
        ]
      }
    },
    {
      "appid": "multi-filter-routing",
      "bootstrap": "kafka:9092",
      "input": "orders",
      "threads": 4,
      "routing": {
        "routing_type": "filter",
        "destinations": [
          {
            "output": "premium-orders",
            "filter": "/tier,==,premium",
            "transform": "/data"
          },
          {
            "output": "high-value-orders",
            "filter": "/amount,>,1000",
            "transform": "CONSTRUCT:id=/order_id:amount=/amount:customer=/customer/id"
          },
          {
            "output": "regional-orders-us",
            "filter": "/region,==,us",
            "transform": "/data",
            "partition": "/state"
          }
        ]
      }
    }
  ]
}
